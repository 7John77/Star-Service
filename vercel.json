{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "images": {
    "sizes": [160, 384, 768],
    "qualities": [75],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "mobiakcare.com",
        "pathname": "/sites/default/files/**"
      }
    ],
    "minimumCacheTTL": 86400,
    "formats": ["image/webp"]
  },
  "rewrites": [
    {
      "source": "/api/studies",
      "destination": "/api/star-service"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' https://www.mobiakfire.com https://mobiakcare.com; style-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'"
        }
      ]
    }
  ]
}
